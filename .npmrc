# sharp (a transitive dep of @xenova/transformers, used by the local STT
# pipeline in dsh-host-apiproxy) downloads its libvips binary from GitHub by
# default, which is unreachable in mainland networks. Route it through the
# npmmirror binary mirror instead.
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
