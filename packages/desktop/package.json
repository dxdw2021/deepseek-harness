{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Native desktop wrapper for DeepSeek Harness Web GUI - provides window management, system tray, and auto-update",
  "version": "0.1.0-rc.1",
  "author": "DeepSeek AI",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx scripts/dev.mjs",
    "dev:external": "tsx scripts/dev.mjs --external-dsh",
    "build": "pnpm run build:dsh && pnpm run build:electron",
    "build:electron": "tsc && electron-builder",
    "build:electron:win": "tsc && electron-builder --win",
    "build:electron:mac": "tsc && electron-builder --mac",
    "build:electron:linux": "tsc && electron-builder --linux",
    "build:dsh": "pnpm --filter @deepseek-ai/dsh-cli build && pnpm run bundle:dsh && pnpm run ensure-node",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "ensure-node": "node scripts/ensure-node.mjs",
    "preview": "electron dist/main/index.js",
    "clean": "rimraf dist dist/installers resources/dsh resources/node"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.6.1",
    "@types/node": "^22.20.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
